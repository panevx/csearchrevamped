    <string name="setup_title">Set up screen search</string>
    <string name="step_service_title">1 · Screen capture</string>
    <string name="step_service_body">Turn on the CSearch Revamped accessibility service. It only takes a screenshot when you trigger a search.\n\nIf Android says the setting is restricted: App info → ⋮ → Allow restricted settings, then try again.</string>
    <string name="step_service_button">Open accessibility settings</string>
    <string name="step_assist_title">2 · Long-press home (optional)</string>
    <string name="step_assist_body">Set CSearch Revamped as your digital assistant app, then long-press home or the gesture bar to start a search.</string>
    <string name="step_assist_button">Choose assistant app</string>
    <string name="step_tile_title">3 · Quick Settings tiles (optional)</string>
